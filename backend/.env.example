# ==============================================================================
# TriNetra - Legal Metrology Compliance Inspection System Environment Config
# ==============================================================================

# Application Metadata
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="TriNetra - Legal Metrology Compliance Inspection"
API_V1_STR=/api

# Database Connection (SQLite default for MVP, switch to Postgres if desired)
DATABASE_URL=sqlite:///./data/trinetra.db
# DATABASE_URL=postgresql://trinetra_user:trinetra_pass@localhost:5432/trinetra_db

# Security & Authentication (Required: Generate a strong random key >= 32 characters)
SECRET_KEY=<generate-a-real-secret-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=trinetra_session
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=True

# Optional Local Development Seed Accounts (Development Only - Never configure in production)
# DEFAULT_ADMIN_EMAIL=admin@trinetra.gov.in
# DEFAULT_ADMIN_PASSWORD=<configured-securely-for-dev-only>
# DEFAULT_OFFICER_EMAIL=officer@trinetra.gov.in
# DEFAULT_OFFICER_PASSWORD=<configured-securely-for-dev-only>


# File Upload Storage (Outside source code directory)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
