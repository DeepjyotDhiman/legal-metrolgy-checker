# ==============================================================================
# TriNetra - Legal Metrology Compliance Inspection System Environment Config
# ==============================================================================

# Application Metadata
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="TriNetra - Legal Metrology Compliance Inspection"
API_V1_STR=/api

# Database Connection (SQLite default for MVP, switch to Postgres if desired)
DATABASE_URL=sqlite:///./data/trinetra.db
# DATABASE_URL=postgresql://trinetra_user:trinetra_pass@localhost:5432/trinetra_db

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_string_with_minimum_32_characters_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=trinetra_session
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=True

# File Upload Storage (Outside source code directory)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
