ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite:///./data/trinetra.db
SECRET_KEY=<generate-a-real-secret-at-least-32-characters>
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# Optional development seed variables (Development only)
DEFAULT_ADMIN_EMAIL=<development-admin-email>
DEFAULT_ADMIN_PASSWORD=<development-admin-password>
DEFAULT_OFFICER_EMAIL=<development-officer-email>
DEFAULT_OFFICER_PASSWORD=<development-officer-password>
