# ==============================================================================
# TriNetra Root Environment Config
# ==============================================================================

ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite:///./data/trinetra.db
SECRET_KEY=<generate-a-real-secret-at-least-32-characters>
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

