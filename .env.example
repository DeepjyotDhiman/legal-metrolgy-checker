ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite:///./data/trinetra.db
SECRET_KEY=<generate-a-real-secret-at-least-32-characters>
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# Development-only first-admin bootstrap (ENVIRONMENT=development ONLY, NEVER used in production)
# When the database contains zero administrators, setting DEV_BOOTSTRAP_ADMIN_PASSWORD
# allows the backend to bootstrap the initial ADMIN account so that officer registrations can be approved.
# In production, automatic admin creation is strictly disabled.
DEV_BOOTSTRAP_ADMIN_EMAIL=admin@trinetra.gov.in
DEV_BOOTSTRAP_ADMIN_PASSWORD=<strong-dev-admin-password>
